// JenkinsFile
// Declarative Jenkins pipeline for Python Playwright on Windows build agents

pipeline {
  agent any
  tools {
    git 'Default'
  }
  options { timestamps() }
  parameters {
    choice(
      name: 'TEST_SUITE',
      choices: ['e2e', 'master', 'sanity', 'regression', 'api', 'web', 'datadriven'],
      description: 'Select the pytest marker/suite to run'
    )
    choice(
      name: 'BROWSER',
      choices: ['chromium', 'firefox', 'webkit'],
      description: 'Select the browser for tests'
    )
    choice(
      name: 'MODE',
      choices: ['headless', 'headed'],
      description: 'Run tests in headless or headed mode'
    )
  }
  environment {
    ENV = 'test'
    CI = '1'
    BASE_URL = credentials('SAUCE_BASE_URL')
    // Uncomment and match the IDs in Jenkins Credentials if your .env has more variables:
    // USERNAME = credentials('SAUCE_USERNAME')
    // PASSWORD = credentials('SAUCE_PASSWORD')
  }
  stages {
    stage('🔄 Checkout') {
      steps {
        checkout scm
      }
    }
    stage('📦 Setup Python Venv & Dependencies') {
      steps {
        powershell '''
          if (-not (Test-Path ".\\venv\\Scripts\\python.exe")) {
              $pythonExe = $null
              $searchPatterns = @(
                  "$env:LOCALAPPDATA\\Programs\\Python\\Python*\\python.exe",
                  "C:\\Users\\Dell\\AppData\\Local\\Programs\\Python\\Python*\\python.exe",
                  "C:\\Program Files\\Python*\\python.exe",
                  "C:\\Python*\\python.exe"
              )

              foreach ($pattern in $searchPatterns) {
                  $found = Get-Item $pattern -ErrorAction SilentlyContinue | Sort-Object FullName -Descending | Select-Object -First 1
                  if ($found) {
                      $pythonExe = $found.FullName
                      break
                  }
              }

              if (-not $pythonExe) {
                  $cmd = Get-Command python -ErrorAction SilentlyContinue
                  if ($cmd -and ($cmd.Source -notlike "*WindowsApps*")) {
                      $pythonExe = $cmd.Source
                  }
              }

              if (-not $pythonExe) {
                  throw "Real Python installation not found!"
              }

              Write-Host "Using Python: $pythonExe"
              & $pythonExe -m venv venv
          }

          .\\venv\\Scripts\\python.exe -m pip install --upgrade pip
          .\\venv\\Scripts\\pip.exe install -r requirements.txt
        '''
      }
    }
    stage('🤖 Install Playwright Browsers & Env') {
      steps {
        powershell '''
          .\\venv\\Scripts\\playwright.exe install
          if (-not (Test-Path .env) -and (Test-Path .env.example)) { Copy-Item .env.example .env }
        '''
      }
    }
    stage('▶️ Run Playwright Tests') {
      steps {
        script {
          def marker = params.TEST_SUITE
          def browserFlag = "--browser=${params.BROWSER}"
          def modeFlag = params.MODE == 'headed' ? '--headed' : ''
          powershell """
            if (Test-Path "reports") { Remove-Item -Recurse -Force "reports" }
            New-Item -ItemType Directory -Force -Path "reports\\allure-results" | Out-Null
            .\\venv\\Scripts\\pytest.exe -m ${marker} ${browserFlag} ${modeFlag} --alluredir=reports/allure-results --junitxml=reports/results.xml | Tee-Object -FilePath "reports\\pytest-output.txt"
            exit \$LASTEXITCODE
          """
        }
      }
    }
  }
  post {
    always {
      archiveArtifacts artifacts: 'reports/**,test-results/**', allowEmptyArchive: true
      junit testResults: 'reports/results.xml', allowEmptyResults: true
      allure([
        includeProperties: false,
        jdk: '',
        reportBuildPolicy: 'ALWAYS',
        results: [[path: 'reports/allure-results']]
      ])
      emailext(
        subject: "Jenkins Build: ${env.JOB_NAME} #${env.BUILD_NUMBER} - ${currentBuild.currentResult}",
        body: """
            <h2>Python Playwright Test Execution Report</h2>
            <p><b>Job:</b> ${env.JOB_NAME}</p>
            <p><b>Build:</b> #${env.BUILD_NUMBER}</p>
            <p><b>Status:</b> ${currentBuild.currentResult}</p>
            <p><b>Test Suite:</b> ${params.TEST_SUITE}</p>
            <p><b>Browser:</b> ${params.BROWSER}</p>
            <p>
              <a href="${env.BUILD_URL}">Open Jenkins Build</a> |
              <a href="${env.BUILD_URL}allure">Open Allure Report</a>
            </p>
        """,
        to: "venkatamanisha9@gmail.com",
        from: "venkatamanisha9@gmail.com",
        replyTo: "venkatamanisha9@gmail.com",
        mimeType: "text/html"
      )
    }
  }
}
